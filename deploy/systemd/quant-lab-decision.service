[Unit]
Description=quant-lab compact input and signed decision publication
After=network-online.target

[Service]
Type=oneshot
User=quantlab
Group=quantlab
SupplementaryGroups=quant-decision
UMask=0027
WorkingDirectory=/opt/quant-lab
EnvironmentFile=/etc/quant-lab/decision/runtime.env
EnvironmentFile=-/etc/quant-lab/okx_readonly.env
Environment=POLARS_MAX_THREADS=1
ExecStart=/usr/bin/flock -w 10 /var/lib/quant-lab/decision/publication.lock /opt/quant-lab/.venv/bin/qlab decision cloud-cycle --code-revision ${QUANT_LAB_CODE_REVISION}
TimeoutStartSec=150
MemoryMax=1G
CPUQuota=50%
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
