[Unit]
Description=Submit today's authoritative NAS Expert Export request
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quantlab
Group=quantlab
SupplementaryGroups=quant-export
WorkingDirectory=/opt/quant-lab
EnvironmentFile=/etc/quant-lab/export-plane.env
Environment=PYTHONUNBUFFERED=1
ExecCondition=/bin/bash -lc '[ "${QUANT_LAB_NAS_EXPORT_ENABLED:-0}" = "1" ]'
ExecStart=/opt/quant-lab/.venv/bin/python /opt/quant-lab/tools/quant_export_queue.py request --queue-root ${QUANT_LAB_EXPORT_QUEUE_ROOT} --date today --mode authoritative
Nice=10
CPUQuota=10%
MemoryHigh=128M
MemoryMax=256M
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/quant-lab
ReadWritePaths=/var/lib/quant-lab/export_queue
