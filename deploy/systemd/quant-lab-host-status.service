[Unit]
Description=quant-lab lightweight host status snapshot

[Service]
Type=oneshot
User=quantlab
Group=quantlab
SupplementaryGroups=quant-decision
UMask=0027
ExecStart=/usr/bin/python3 /opt/quant-lab/src/quant_lab/decision/host_metrics.py qyun2 --output /var/lib/quant-lab/decision/status/qyun2.json
TimeoutStartSec=25
MemoryMax=64M
CPUQuota=10%
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quant-lab/decision/status

